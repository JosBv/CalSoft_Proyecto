# Copia este archivo a ".env" y ajusta los valores.
# El archivo .env NO se sube a git (está en .gitignore).

# Puerto del servidor
PORT=3000

# --- Conexión a PostgreSQL ---
# Opción A: una sola URL de conexión
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/restaurante

# Opción B: variables sueltas (se usan si no defines DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=restaurante

# --- Seguridad (JWT) ---
# Cámbialo por una cadena larga y aleatoria en producción.
JWT_SECRET=cambia-esta-clave-secreta-en-produccion
JWT_EXPIRES=8h
